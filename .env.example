# Telegram relay
RELAY_URL=https://relay.example.com/webhook/telegram
RELAY_AUTH=REPLACE_WITH_RELAY_SECRET
TG_TOKEN=REPLACE_WITH_GROUP_BOT_KEY
TG_CHAT_ID=REPLACE_WITH_CHAT_ID
SERVER_NAME=
RELAY_TIMEOUT_SEC=12

# CPU: average utilization between checks (~5 min); first check saves baseline
# 3 consecutive averages above threshold (~15 min after baseline)
CPU_MAX_PERCENT=90
CPU_CONSECUTIVE_CHECKS=3

# Kernel 5-minute load average per logical CPU (not CPU utilization percent)
CHECK_LOAD_AVERAGE=1
LOAD5_MAX_PER_CPU=1.0
LOAD_CONSECUTIVE_CHECKS=2

RAM_MAX_PERCENT=90
RAM_CONSECUTIVE_CHECKS=2
SWAP_MAX_PERCENT=80
SWAP_CONSECUTIVE_CHECKS=2

# Filesystem paths; thresholds combined with OR; 0 disables threshold
DISK_PATHS=/
DISK_MIN_FREE_GB=5
DISK_MIN_FREE_PERCENT=10
CHECK_INODES=1
INODES_MIN_FREE_PERCENT=5

# 0 = no repeat alerts
REMIND_EVERY_HOURS=12
NOTIFY_ON_FIRST_RUN=1
